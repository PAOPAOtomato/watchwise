# Secrets and local overrides. `watchwise init` copies this to .env (never
# overwriting an existing .env); .env is git-ignored. config/watchwise.yml only
# ever names these variables; it never contains a key.
#
# A key just for Watchwise (recommended): use the WATCHWISE_ name. It wins over
# the provider's usual variable, so Watchwise never uses a key that other tools
# on this machine share, and its spend shows up separately on your provider
# dashboard. Uncomment only what you use: an empty KEY= line can stop an SDK
# from finding credentials you configured elsewhere.

# WATCHWISE_OPENAI_API_KEY=
# WATCHWISE_ANTHROPIC_API_KEY=
# WATCHWISE_GEMINI_API_KEY=
# WATCHWISE_GROQ_API_KEY=
# WATCHWISE_OPENROUTER_API_KEY=

# Or a key shared with other tools, under the provider's usual name:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Phone alerts: the token @BotFather gives you for your own bot.
# Then run `watchwise telegram link`.
# WATCHWISE_TELEGRAM_BOT_TOKEN=

# Where things are when Watchwise runs on the host. docker compose sets these
# itself for the container, so leave them commented unless yours differ.
# FRIGATE_URL=http://localhost:5000
# MQTT_HOST=localhost
# OLLAMA_URL=http://localhost:11434
