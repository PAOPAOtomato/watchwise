# Secrets and local overrides. `sentinel init` copies this to .env (never
# overwriting an existing .env); .env is git-ignored. config/sentinel.yml only
# ever names these variables, it never contains a key.
#
# Uncomment only the provider you use. An empty KEY= line can stop an SDK
# from finding credentials you configured elsewhere.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Where things are when Sentinel runs on the host. docker compose sets these
# itself for the container, so leave them commented unless yours differ.
# FRIGATE_URL=http://localhost:5000
# MQTT_HOST=localhost
# OLLAMA_URL=http://localhost:11434
